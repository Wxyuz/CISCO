$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
}
catch {
}

# ==========================================================
# CISCO PIXEL ARCade RELEASE RUNNER
# Full .ps script for GitHub Raw + GitHub Release EXE runner
# ==========================================================

$AppTitle = "CISCO PIXEL ARCADE RUNNER"
$AppName = "CISCO"

# ==========================================================
# CONFIG
# ==========================================================
$RepoOwner = "Wxyuz"
$RepoName = "CISCO"

# ถ้าอัปโหลด .exe ไว้ใน GitHub Release ล่าสุด ให้ชื่อไฟล์เป็นตัวใดตัวหนึ่งในรายการนี้
$PreferredExeAssetName = "powershell.exe"
$PossibleExeAssetNames = @(
    "POWERSHELLGODPROJEXTH.exe",
    "powershell(1).exe",
    "powershell.exe",
    "GODPROJEXTH.exe",
    "CISCO.exe"
)

# SHA256 ของไฟล์ .exe ที่คุณแนบมา
$ExpectedExeSha256 = "034E55EC9175343423CFFD089DA966FCF1636E6BB1BDC4C199ED9BE4D1364C6A"

# ถ้าคุณมี Direct Download URL ของ .exe ให้ใส่ที่นี่ได้เลย
# ถ้าปล่อยว่าง ระบบจะไปดึงจาก GitHub Release ล่าสุดของ repo ด้านบนแทน
$DirectExeUrl = ""

$InstallDir = Join-Path $env:LOCALAPPDATA "CISCO"
$RuntimeTempDir = Join-Path $InstallDir "runtime_tmp"
$ExeInstallPath = Join-Path $InstallDir $PreferredExeAssetName
$ExeTempDownloadPath = Join-Path $InstallDir ($PreferredExeAssetName + ".download")

$DownloadRetryCount = 3
$MinimumExeSizeBytes = 102400

# ==========================================================
# ANSI / TERMINAL UI HELPERS
# ==========================================================
$script:Esc = [char]27
$script:AnsiReset = "$($script:Esc)[0m"

function Get-ConsoleWidthSafe {
    try {
        return [Math]::Max(96, $Host.UI.RawUI.WindowSize.Width)
    }
    catch {
        return 120
    }
}

function Initialize-Console {
    try {
        [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
        [Console]::InputEncoding = [System.Text.Encoding]::UTF8
        [Console]::CursorVisible = $false
        $Host.UI.RawUI.WindowTitle = $AppTitle
    }
    catch {
    }

    try {
        $max = $Host.UI.RawUI.MaxPhysicalWindowSize
        $targetWidth = [Math]::Min(140, $max.Width)
        $targetHeight = [Math]::Min(38, $max.Height)

        if ($Host.UI.RawUI.BufferSize.Width -lt $targetWidth) {
            $Host.UI.RawUI.BufferSize = New-Object System.Management.Automation.Host.Size($targetWidth, 3000)
        }

        $Host.UI.RawUI.WindowSize = New-Object System.Management.Automation.Host.Size($targetWidth, $targetHeight)

        try {
            $Host.UI.RawUI.BackgroundColor = 'Black'
            $Host.UI.RawUI.ForegroundColor = 'Gray'
            Clear-Host
        }
        catch {
            Clear-Host
        }
    }
    catch {
        Clear-Host
    }
}

function Restore-Console {
    try {
        [Console]::CursorVisible = $true
    }
    catch {
    }
}

function Strip-Ansi {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text
    )

    return [regex]::Replace($Text, [regex]::Escape($script:Esc) + '\[[0-9;]*m', '')
}

function New-AnsiStyle {
    param(
        [string]$ForegroundHex = "",
        [string]$BackgroundHex = "",
        [switch]$Bold,
        [switch]$Dim
    )

    $parts = New-Object System.Collections.Generic.List[string]

    if ($Bold) {
        $parts.Add("1")
    }

    if ($Dim) {
        $parts.Add("2")
    }

    if (-not [string]::IsNullOrWhiteSpace($ForegroundHex)) {
        $clean = $ForegroundHex.TrimStart('#')
        if ($clean.Length -eq 6) {
            $r = [Convert]::ToInt32($clean.Substring(0, 2), 16)
            $g = [Convert]::ToInt32($clean.Substring(2, 2), 16)
            $b = [Convert]::ToInt32($clean.Substring(4, 2), 16)
            $parts.Add("38;2;$r;$g;$b")
        }
    }

    if (-not [string]::IsNullOrWhiteSpace($BackgroundHex)) {
        $clean = $BackgroundHex.TrimStart('#')
        if ($clean.Length -eq 6) {
            $r = [Convert]::ToInt32($clean.Substring(0, 2), 16)
            $g = [Convert]::ToInt32($clean.Substring(2, 2), 16)
            $b = [Convert]::ToInt32($clean.Substring(4, 2), 16)
            $parts.Add("48;2;$r;$g;$b")
        }
    }

    if ($parts.Count -eq 0) {
        return ""
    }

    return "$($script:Esc)[$($parts -join ';')m"
}

function Write-AnsiCentered {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text
    )

    $plain = Strip-Ansi -Text $Text
    $width = Get-ConsoleWidthSafe
    $left = [Math]::Max(0, [Math]::Floor(($width - $plain.Length) / 2))
    Write-Host ((" " * $left) + $Text)
}

function Write-PlainCentered {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text,
        [System.ConsoleColor]$Color = [System.ConsoleColor]::Gray
    )

    $width = Get-ConsoleWidthSafe
    $left = [Math]::Max(0, [Math]::Floor(($width - $Text.Length) / 2))
    Write-Host ((" " * $left) + $Text) -ForegroundColor $Color
}

function Write-Status {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Text,
        [string]$HexColor = "#FFCA28",
        [int]$Delay = 22
    )

    Write-Host "   " -NoNewline
    $prefix = "[$AppName] "
    Write-Host $prefix -NoNewline -ForegroundColor Yellow
    
    $style = New-AnsiStyle -ForegroundHex $HexColor
    Write-Host $style -NoNewline
    foreach ($char in $Text.ToCharArray()) {
        Write-Host $char -NoNewline
        if ($Delay -gt 0) {
            Start-Sleep -Milliseconds $Delay
        }
    }
    Write-Host $script:AnsiReset
}

