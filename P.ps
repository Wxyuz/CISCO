$ErrorActionPreference = "Stop"
$ProgressPreference = "Continue"

try {
    [Console]::OutputEncoding = [System.Text.Encoding]::UTF8
    $OutputEncoding = [System.Text.Encoding]::UTF8
}
catch {
}

try {
    [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
}
catch {
}

# ==========================================================
# CISCO LOADER
# Script  : https://github.com/Wxyuz/CISCO/blob/main/P.ps
# Raw     : https://raw.githubusercontent.com/Wxyuz/CISCO/main/P.ps
# Release : https://github.com/Wxyuz/CISCO/releases/tag/v1.0.0
# Asset   : powershell.exe
# ==========================================================

$AppTitle = "CISCO LOADER"

$RepoOwner = "Wxyuz"
$RepoName = "CISCO"
$BranchName = "main"
$TagName = "v1.0.0"

$ScriptName = "P.ps"
$ReleaseAssetName = "powershell.exe"
$LocalExeName = "powershell.exe"

$RepoUrl = "https://github.com/$RepoOwner/$RepoName"
$ScriptPage = "https://github.com/$RepoOwner/$RepoName/blob/$BranchName/$ScriptName"
$RawScriptUrl = "https://raw.githubusercontent.com/$RepoOwner/$RepoName/$BranchName/$ScriptName"
$ReleasePage = "https://github.com/$RepoOwner/$RepoName/releases/tag/$TagName"
$DownloadUrl = "https://github.com/$RepoOwner/$RepoName/releases/download/$TagName/$ReleaseAssetName"

function Get-SafeLocalAppData {
    if (![string]::IsNullOrWhiteSpace($env:LOCALAPPDATA)) {
        return $env:LOCALAPPDATA
    }

    if (![string]::IsNullOrWhiteSpace($env:USERPROFILE)) {
        return (Join-Path $env:USERPROFILE "AppData\Local")
    }

    return $PWD.Path
}

$InstallRoot = Join-Path (Get-SafeLocalAppData) "Wxyuz"
$InstallDir = Join-Path $InstallRoot "CISCO"
$OutFile = Join-Path $InstallDir $LocalExeName
$TempFile = "$OutFile.download"

$LauncherMutexName = "Wxyuz_CISCO_Loader_v1_0_0"
$LauncherMutex = $null
$LauncherMutexCreated = $false

function Write-Info {
    param([string]$Text)
    Write-Host "[+] $Text" -ForegroundColor Cyan
}

function Write-Ok {
    param([string]$Text)
    Write-Host "[OK] $Text" -ForegroundColor Green
}

function Write-Warn {
    param([string]$Text)
    Write-Host "[!] $Text" -ForegroundColor Yellow
}

function Write-Err {
    param([string]$Text)
    Write-Host "[ERROR] $Text" -ForegroundColor Red
}

function Format-Bytes {
    param([Int64]$Bytes)

    if ($Bytes -ge 1GB) {
        return ("{0:N2} GB" -f ($Bytes / 1GB))
    }

    if ($Bytes -ge 1MB) {
        return ("{0:N2} MB" -f ($Bytes / 1MB))
    }

    if ($Bytes -ge 1KB) {
        return ("{0:N2} KB" -f ($Bytes / 1KB))
    }

    return "$Bytes Bytes"
}

function Show-Header {
    try {
        Clear-Host
    }
    catch {
    }

    try {
        $Host.UI.RawUI.WindowTitle = $AppTitle
    }
    catch {
    }

    Write-Host "====================================================" -ForegroundColor Yellow
    Write-Host "                    CISCO LOADER                    " -ForegroundColor Yellow
    Write-Host "====================================================" -ForegroundColor Yellow
    Write-Host ""

    Write-Info "Script  : $ScriptPage"
    Write-Info "Raw     : $RawScriptUrl"
    Write-Info "Release : $ReleasePage"
    Write-Info "Asset   : $ReleaseAssetName"
    Write-Info "URL     : $DownloadUrl"
    Write-Info "Save To : $OutFile"
    Write-Host ""
}

function Ensure-Folder {
    param([string]$Path)

    if (!(Test-Path -LiteralPath $Path)) {
        New-Item -ItemType Directory -Path $Path -Force | Out-Null
    }
}

function Normalize-PathSafe {
    param([string]$Path)

    try {
        return ([System.IO.Path]::GetFullPath($Path).TrimEnd('\'))
    }
    catch {
        return $Path
    }
}

function Test-WindowsExe {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Path
    )

    if (!(Test-Path -LiteralPath $Path)) {
        return $false
    }

    $Stream = $null

    try {
        $Stream = [System.IO.File]::Open(
            $Path,
            [System.IO.FileMode]::Open,
            [System.IO.FileAccess]::Read,
            [System.IO.FileShare]::ReadWrite
        )

        if ($Stream.Length -lt 2) {
            return $false
        }

        $Buffer = New-Object byte[] 2
        [void]$Stream.Read($Buffer, 0, 2)

        if ($Buffer[0] -eq 0x4D -and $Buffer[1] -eq 0x5A) {
            return $true
        }

        return $false
    }
    catch {
        return $false
    }
    finally {
        if ($null -ne $Stream) {
            try {
                $Stream.Close()
            }
            catch {
            }
        }
    }
}

function Add-WindowTools {
    try {
        if (!("CISCO_WindowTools.Win32Window" -as [type])) {
            Add-Type @"
using System;
using System.Runtime.InteropServices;

namespace CISCO_WindowTools
{
    public static class Win32Window
    {
        [DllImport("user32.dll")]
        public static extern bool ShowWindowAsync(IntPtr hWnd, int nCmdShow);

        [DllImport("user32.dll")]
        public static extern bool SetForegroundWindow(IntPtr hWnd);
    }
}
"@
        }
    }
    catch {
    }
}

function Restore-AppWindow {
    param([int]$ProcessId)

    try {
        Add-WindowTools

        $Process = Get-Process -Id $ProcessId -ErrorAction Stop

        if ($Process.MainWindowHandle -ne 0) {
            [void][CISCO_WindowTools.Win32Window]::ShowWindowAsync($Process.MainWindowHandle, 9)
            [void][CISCO_WindowTools.Win32Window]::SetForegroundWindow($Process.MainWindowHandle)
            return $true
        }
    }
    catch {
    }

    return $false
}

function Get-RunningGuiProcess {
    $TargetPath = Normalize-PathSafe $OutFile
    $Result = New-Object System.Collections.Generic.List[object]

    try {
        $Processes = Get-CimInstance Win32_Process -ErrorAction Stop

        foreach ($ProcessItem in $Processes) {
            if ($null -ne $ProcessItem.ExecutablePath) {
                $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                if ($ProcessPath -ieq $TargetPath) {
                    [void]$Result.Add($ProcessItem)
                }
            }
        }
    }
    catch {
        try {
            $Processes = Get-WmiObject Win32_Process -ErrorAction Stop

            foreach ($ProcessItem in $Processes) {
                if ($null -ne $ProcessItem.ExecutablePath) {
                    $ProcessPath = Normalize-PathSafe $ProcessItem.ExecutablePath

                    if ($ProcessPath -ieq $TargetPath) {
                        [void]$Result.Add($ProcessItem)
                    }
                }
            }
        }
        catch {
        }
    }

    return $Result.ToArray()
}

function Remove-TempFile {
    if (Test-Path -LiteralPath $TempFile) {
        try {
            Remove-Item -LiteralPath $TempFile -Force
        }
        catch {
        }
    }
}

function Invoke-DownloadFileWithProgress {
    param(
        [Parameter(Mandatory = $true)]
        [string]$Url,

        [Parameter(Mandatory = $true)]
        [string]$Destination
    )

    $Request = $null
    $Response = $null
    $InputStream = $null
    $OutputStream = $null

    try {
        $Request = [System.Net.HttpWebRequest]::Create($Url)
        $Request.Method = "GET"
        $Request.AllowAutoRedirect = $true
        $Request.MaximumAutomaticRedirections = 10
        $Request.UserAgent = "Mozilla/5.0 CISCO-Loader"
        $Request.Timeout = 30000
        $Request.ReadWriteTimeout = 30000
        $Request.KeepAlive = $false

        $Response = $Request.GetResponse()
        $InputStream = $Response.GetResponseStream()

        $OutputStream = [System.IO.File]::Open(
            $Destination,
            [System.IO.FileMode]::Create,
            [System.IO.FileAccess]::Write,
            [System.IO.FileShare]::None
        )

        $TotalBytes = [Int64]$Response.ContentLength
        $TotalRead = [Int64]0
        $Buffer = New-Object byte[] 65536

        while ($true) {
            $Read = $InputStream.Read($Buffer, 0, $Buffer.Length)

            if ($Read -le 0) {
                break
            }

            $OutputStream.Write($Buffer, 0, $Read)
            $TotalRead += $Read

            if ($TotalBytes -gt 0) {
                $Percent = [int](($TotalRead * 100) / $TotalBytes)

                if ($Percent -lt 0) {
                    $Percent = 0
                }

                if ($Percent -gt 100) {
                    $Percent = 100
                }

                $StatusText = "$(Format-Bytes $TotalRead) / $(Format-Bytes $TotalBytes)"
                Write-Progress -Activity "Downloading CISCO GUI..." -Status $StatusText -PercentComplete $Percent
            }
            else {
                $StatusText = "$(Format-Bytes $TotalRead)"
                Write-Progress -Activity "Downloading CISCO GUI..." -Status $StatusText -PercentComplete 0
            }
        }

        Write-Progress -Activity "Downloading CISCO GUI..." -Completed

        if (!(Test-Path -LiteralPath $Destination)) {
            throw "Download failed. File not created."
        }

        $DownloadedItem = Get-Item -LiteralPath $Destination

        if ($DownloadedItem.Length -le 0) {
            throw "Download failed. File size is 0 bytes."
        }
    }
    catch [System.Net.WebException] {
        $Message = $_.Exception.Message

        try {
            if ($null -ne $_.Exception.Response) {
                $StatusCode = [int]$_.Exception.Response.StatusCode
                $StatusDescription = $_.Exception.Response.StatusDescription
                $Message = "HTTP $StatusCode $StatusDescription - $Message"
            }
        }
        catch {
        }

        throw $Message
    }
    finally {
        Write-Progress -Activity "Downloading CISCO GUI..." -Completed

        if ($null -ne $OutputStream) {
            try {
                $OutputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $InputStream) {
            try {
                $InputStream.Close()
            }
            catch {
            }
        }

        if ($null -ne $Response) {
            try {
                $Response.Close()
            }
            catch {
            }
        }
    }
}

function Download-Loader {
    Ensure-Folder -Path $InstallDir
    Remove-TempFile

    Write-Info "Downloading Release Asset..."
    Write-Info "From : $DownloadUrl"
    Write-Info "To   : $OutFile"
    Write-Host ""

    Invoke-DownloadFileWithProgress -Url $DownloadUrl -Destination $TempFile

    if (!(Test-Path -LiteralPath $TempFile)) {
        throw "Download failed. Temp file not found."
    }

    if (!(Test-WindowsExe -Path $TempFile)) {
        try {
            Remove-Item -LiteralPath $TempFile -Force
        }
        catch {
        }

        throw "Downloaded file is not a valid Windows EXE. Check Release Asset name: $ReleaseAssetName"
    }

    if (Test-Path -LiteralPath $OutFile) {
        try {
            Remove-Item -LiteralPath $OutFile -Force
        }
        catch {
            throw "Cannot replace old file because GUI is still running or locked. Close CISCO GUI first, then run again."
        }
    }

    Move-Item -LiteralPath $TempFile -Destination $OutFile -Force

    Write-Ok "Download complete"
    Write-Info "Saved to: $OutFile"
    Write-Host ""
}

function Verify-Loader {
    Write-Info "Checking downloaded file..."

    if (!(Test-Path -LiteralPath $OutFile)) {
        throw "File not found: $OutFile"
    }

    if (!(Test-WindowsExe -Path $OutFile)) {
        throw "File is not a valid Windows EXE: $OutFile"
    }

    $Item = Get-Item -LiteralPath $OutFile

    Write-Ok "Valid Windows EXE"
    Write-Info "Size: $(Format-Bytes $Item.Length)"

    Write-Info "SHA256:"
    Get-FileHash -LiteralPath $OutFile -Algorithm SHA256 | Format-List

    Write-Host ""
}

function Start-GuiOnce {
    $Running = @(Get-RunningGuiProcess)
    $RunningCount = $Running.Length

    if ($RunningCount -gt 0) {
        Write-Warn "CISCO GUI is already running. Not opening duplicate."

        foreach ($Item in $Running) {
            try {
                [void](Restore-AppWindow -ProcessId ([int]$Item.ProcessId))
            }
            catch {
            }
        }

        Write-Ok "Existing GUI restored"
        Write-Host ""
        return
    }

    Write-Info "Opening GUI..."
    Write-Info "File: $OutFile"
    Write-Host ""

    $Process = Start-Process `
        -FilePath $OutFile `
        -WorkingDirectory $InstallDir `
        -WindowStyle Normal `
        -PassThru

    Start-Sleep -Seconds 2

    try {
        $Process.Refresh()

        if ($Process.HasExited) {
            throw "GUI opened and closed immediately. ExitCode: $($Process.ExitCode)"
        }
    }
    catch {
        throw $_
    }

    Write-Ok "GUI started successfully"
    Write-Info "PID: $($Process.Id)"
    Write-Host ""
}

try {
    $LauncherMutex = New-Object System.Threading.Mutex($true, $LauncherMutexName, [ref]$LauncherMutexCreated)

    Show-Header

    if (-not $LauncherMutexCreated) {
        Write-Warn "Loader is already running. Please wait."
        Start-Sleep -Seconds 3
        exit
    }

    $AlreadyRunning = @(Get-RunningGuiProcess)
    $AlreadyRunningCount = $AlreadyRunning.Length

    if ($AlreadyRunningCount -gt 0) {
        Write-Warn "CISCO GUI is already open."

        foreach ($Item in $AlreadyRunning) {
            try {
                [void](Restore-AppWindow -ProcessId ([int]$Item.ProcessId))
            }
            catch {
            }
        }

        Write-Ok "No duplicate GUI opened"
        Start-Sleep -Seconds 2
        exit
    }

    Download-Loader
    Verify-Loader
    Start-GuiOnce

    Write-Ok "Finished"
    Start-Sleep -Seconds 2
}
catch {
    Write-Host ""
    Write-Err $_.Exception.Message
    Write-Host ""

    Write-Warn "Checklist:"
    Write-Host "1. ไฟล์ Script ใน GitHub ต้องชื่อ P.ps ไม่ใช่ P.ps1" -ForegroundColor Yellow
    Write-Host "2. Raw URL ต้องเป็น: https://raw.githubusercontent.com/Wxyuz/CISCO/main/P.ps" -ForegroundColor Yellow
    Write-Host "3. Repo ต้องเป็น Public: https://github.com/Wxyuz/CISCO" -ForegroundColor Yellow
    Write-Host "4. Release ต้องเป็น: https://github.com/Wxyuz/CISCO/releases/tag/v1.0.0" -ForegroundColor Yellow
    Write-Host "5. ใน Release Assets ต้องมีไฟล์ชื่อ powershell.exe" -ForegroundColor Yellow
    Write-Host "6. ถ้า GUI ล็อก HWID หรือ KeyAuth เครื่องอื่นจะใช้ไม่ได้จนกว่าจะตั้งค่าฝั่ง KeyAuth/โปรแกรม GUI ให้ถูกต้อง" -ForegroundColor Yellow
    Write-Host "7. ถ้า GUI เปิดแล้วปิดทันที แปลว่าปัญหาอยู่ในตัว powershell.exe ไม่ใช่ตัวโหลด P.ps" -ForegroundColor Yellow
    Write-Host ""

    Write-Host "Press Enter to close..." -ForegroundColor DarkGray
    [void][System.Console]::ReadLine()
}
finally {
    if ($null -ne $LauncherMutex) {
        try {
            if ($LauncherMutexCreated) {
                $LauncherMutex.ReleaseMutex()
            }

            $LauncherMutex.Dispose()
        }
        catch {
        }
    }
}
